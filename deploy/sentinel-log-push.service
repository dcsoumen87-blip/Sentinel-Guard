[Unit]
Description=Sentinel Guard Log Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/app
EnvironmentFile=/home/ubuntu/app/.env
ExecStart=/home/ubuntu/app/.venv/bin/python /home/ubuntu/app/scripts/push_logs.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
